// prisma/schema.prisma
// Complete database schema for الرقية الشرعية أونلاين platform.
// After any change run: npx prisma db push  (dev)
//                    or: npx prisma migrate dev --name <description>  (production-ready)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMERATIONS
// ═══════════════════════════════════════════════════════════════════════════

/// User account roles — controls access across the entire platform.
enum Role {
  USER   // Regular visitor / patient
  RAQI   // Certified practitioner — can respond in forum, manage own schedule
  ADMIN  // Full platform control
}

/// Appointment lifecycle.
enum BookingStatus {
  PENDING    // Awaiting raqi confirmation
  CONFIRMED  // Raqi accepted, link will be sent
  CANCELLED  // Cancelled by user or raqi
  COMPLETED  // Session finished
}

/// Moderation state for forum posts.
enum PostStatus {
  PENDING   // Default — awaiting moderator review
  APPROVED  // Visible to all users
  REJECTED  // Hidden — reason can be stored in moderatorNote
}

// ═══════════════════════════════════════════════════════════════════════════
// USER & AUTHENTICATION
// ═══════════════════════════════════════════════════════════════════════════

/// Platform user account (all roles share this model).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)  @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  // Relations
  raqiProfile  RaqiProfile?
  bookings     Booking[]    @relation("UserBookings")
  forumPosts   ForumPost[]
  forumReplies ForumReply[]
  postLikes    PostLike[]

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════
// RAQI PRACTITIONER PROFILE
// ═══════════════════════════════════════════════════════════════════════════

/// Extended profile for users with role = RAQI.
/// One-to-one with User.
model RaqiProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  bio            String?
  certifications String?  // Free-text description of ijazahs / credentials
  specialties    String[] // e.g. ["سحر", "عين", "مس", "تحصين أطفال"]
  isAvailable    Boolean  @default(true)  @map("is_available")
  sessionPrice   Decimal? @map("session_price") @db.Decimal(10, 2)
  avatarUrl      String?  @map("avatar_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("RaqiBookings")

  @@map("raqi_profiles")
}

// ═══════════════════════════════════════════════════════════════════════════
// BOOKINGS
// ═══════════════════════════════════════════════════════════════════════════

/// A session booking between a user and a raqi.
/// Double-booking is prevented at DB level via the @@unique constraint
/// on [raqiId, startTime].
model Booking {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  raqiId      String        @map("raqi_id")

  /// Service selected (maps to frontend card labels)
  serviceType String        @map("service_type")
  // Values: "جلسة رقية فردية مباشرة" | "رقية الأطفال والتحصين المنزلي"
  //         | "استشارة تشخيصية وتوجيه" | "رقية مسجلة مخصصة"

  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")    // startTime + session duration
  status      BookingStatus @default(PENDING)
  notes       String?       // Optional notes from user
  sessionLink String?       @map("session_link") // Video call URL added by raqi after confirm
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt      @map("updated_at")

  // Relations
  user User        @relation("UserBookings", fields: [userId], references: [id])
  raqi RaqiProfile @relation("RaqiBookings", fields: [raqiId], references: [id])

  /// Prevents the same raqi from having two bookings at the same start time.
  /// The slot conflict check in the API also validates overlapping intervals.
  @@unique([raqiId, startTime])
  @@index([userId])
  @@index([raqiId, startTime])
  @@map("bookings")
}

// ═══════════════════════════════════════════════════════════════════════════
// BLOG / ARTICLES
// ═══════════════════════════════════════════════════════════════════════════

/// Knowledge base articles — powers the مدونة الشفاء section.
model Article {
  id           String    @id @default(cuid())
  title        String
  excerpt      String    // Short summary shown in card view
  content      String    @db.Text  // Full HTML/Markdown content
  categoryKey  String    @map("category_key")
  // Values: "sunnah" | "hasad" | "adhkar"
  categoryName String    @map("category_name")
  // Arabic display name e.g. "السنة النبوية"
  author       String
  readTime     String    @map("read_time")  // e.g. "4 دقائق"
  coverImage   String?   @map("cover_image")
  publishedAt  DateTime  @default(now()) @map("published_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")  // Soft delete

  @@index([categoryKey])
  @@index([publishedAt])
  @@map("articles")
}

// ═══════════════════════════════════════════════════════════════════════════
// COMMUNITY FORUM
// ═══════════════════════════════════════════════════════════════════════════

/// A forum thread / post — powers the منتدى مجتمع السكينة section.
/// Posts default to PENDING and must be approved by a moderator (RAQI or ADMIN).
model ForumPost {
  id            String     @id @default(cuid())
  authorName    String     @map("author_name")  // Display name (may be pseudonym)
  title         String
  content       String     @db.Text
  badge         String     // Category badge e.g. "استفسار شرعي" | "تجربة شفاء"
  status        PostStatus @default(PENDING)
  officialReply String?    @map("official_reply") @db.Text  // Pinned reply from a raqi
  moderatorNote String?    @map("moderator_note")           // Internal rejection reason
  likesCount    Int        @default(0) @map("likes_count")
  userId        String?    @map("user_id")  // Null = anonymous / pseudonym post
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt      @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")  // Soft delete

  // Relations
  user    User?        @relation(fields: [userId], references: [id])
  replies ForumReply[]
  likes   PostLike[]

  @@index([status, createdAt])
  @@map("forum_posts")
}

/// A reply to a forum thread.
model ForumReply {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  userId    String    @map("user_id")
  content   String    @db.Text
  isOfficial Boolean  @default(false) @map("is_official")  // True if posted by RAQI/ADMIN
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@index([postId])
  @@map("forum_replies")
}

/// Tracks which users liked which posts (prevents duplicate likes).
model PostLike {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("post_likes")
}

// ═══════════════════════════════════════════════════════════════════════════
// SITE SETTINGS & CMS
// ═══════════════════════════════════════════════════════════════════════════

/// Global site content and settings managed by ADMIN.
model SiteSetting {
  id              String   @id @default("default")
  bannerActive    Boolean  @default(true) @map("banner_active")
  bannerText      String   @default("جميع الرقاة لدينا معتمدون ومجازون في قراءة القرآن الكريم والسنة النبوية الصحيحة بلا بدع") @map("banner_text")
  heroTitle       String   @default("منصة الرقية الشرعية المعتمدة أونلاين") @map("hero_title")
  heroSubtitle    String   @default("تواصل مباشرة بالصوت والصورة مع نخبة من الرقاة والمشايخ المعتمدين والمجازين شرعياً في سرية وأمان تام") @map("hero_subtitle")
  whatsapp        String   @default("+966500000000")
  supportEmail    String   @default("support@roqia.com") @map("support_email")
  sessionDuration Int      @default(45) @map("session_duration")
  bookingNotice   String   @default("يجب تواجد محرم للنساء أثناء الجلسة المرئية") @map("booking_notice")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDIO TRACKS / RECITATION LIBRARY
// ═══════════════════════════════════════════════════════════════════════════

/// Audio recitations for player.
model AudioTrack {
  id          String   @id @default(cuid())
  title       String
  reciter     String
  duration    String?
  category    String   @default("شاملة")
  src         String?
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("audio_tracks")
}

