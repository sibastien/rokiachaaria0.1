# ============================================================
# Ruqyah Online Platform — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Database ---
# For local PostgreSQL: postgresql://USER:PASSWORD@localhost:5432/ruqyah_db
# For Supabase: copy the connection string from Settings > Database > URI
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ruqyah_db"

# --- JWT Authentication ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_very_long_random_secret_string_minimum_64_characters"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=3001
NODE_ENV="development"

# --- CORS ---
# In production behind Nginx reverse proxy, API and frontend share the same origin.
# Add your production domain and local dev ports:
CORS_ORIGIN="https://www.ruqyah-al-shariah.online,https://ruqyah-al-shariah.online,http://127.0.0.1:5500,http://localhost:5500"

# --- Admin Seed ---
# Used only during initial `npm run db:seed`
SEED_ADMIN_EMAIL="admin@ruqyah-online.com"
SEED_ADMIN_PASSWORD="Admin@Ruqyah2024!"
